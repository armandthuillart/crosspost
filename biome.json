{
	"$schema": "https://biomejs.dev/schemas/2.2.2/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedAttributes": "on",
				"useSortedKeys": "on",
				"useSortedProperties": "on"
			}
		},
		"enabled": true
	},
	"files": { "ignoreUnknown": true },
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"javascript": {
		"formatter": { "quoteStyle": "double" }
	},
	"linter": {
		"domains": { "next": "recommended" },
		"enabled": true,
		"rules": {
			"nursery": {
				"useSortedClasses": {
					"fix": "safe",
					"level": "warn",
					"options": {
						"attributes": ["classList"],
						"functions": ["tw", "cn", "cva", "clsx"]
					}
				}
			},
			"recommended": true,
			"suspicious": { "noUnknownAtRules": "off" }
		}
	},
	"overrides": [
		{
			"formatter": { "enabled": false },
			"includes": ["convex/_generated/**", "bun.lock"],
			"linter": { "enabled": false }
		}
	],
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	}
}
